#!/usr/bin/env -S uv run --script
# /// script
# dependencies = ["pyyaml", "uuid-utils"]
# ///
"""
Issue tracking inspired by Google Critique.
States: draft → review → approved → completed/abandoned
The attention set answers: whose turn is it?
"""

import argparse, os, subprocess, sys, tempfile
import uuid_utils as uuid
import yaml
from datetime import datetime
from pathlib import Path

DIR = Path(".issues")

def die(msg):
    print(msg, file=sys.stderr)
    sys.exit(1)

def edit(initial=""):
    editor = os.environ.get("EDITOR", "vi")
    with tempfile.NamedTemporaryFile(suffix=".md", mode="w", delete=False) as f:
        f.write(initial)
        f.flush()
        subprocess.run(f'{editor} "{f.name}"', shell=True)
        return Path(f.name).read_text()

def now():
    return datetime.utcnow().isoformat() + 'Z'

def user():
    try:
        return subprocess.run(["git", "config", "user.name"],
                              capture_output=True, text=True, check=True).stdout.strip()
    except subprocess.CalledProcessError:
        return "unknown"

# --- Persistence ---

def load(id):
    path = DIR / f"{id}.yaml"
    return yaml.safe_load(open(path)) if path.exists() else None

def save(issue):
    issue["updated"] = now()
    yaml.dump(issue, open(DIR / f"{issue['id']}.yaml", "w"),
              default_flow_style=False, sort_keys=False)

def all_issues():
    if not DIR.exists():
        return []
    issues = [yaml.safe_load(open(p)) for p in sorted(DIR.glob("*.yaml"))]
    return sorted([i for i in issues if i], key=lambda i: i['id'])

def index():
    if not DIR.exists():
        return {}
    return {n+1: p.stem for n, p in enumerate(sorted(DIR.glob("*.yaml")))}

def num(id):
    return next((n for n, uid in index().items() if uid == id), 0)

def resolve(arg):
    if arg.isdigit():
        return index().get(int(arg))
    if len(arg) == 32 and (DIR / f"{arg}.yaml").exists():
        return arg
    return None

def fetch(arg):
    id = resolve(arg)
    issue = load(id) if id else None
    if not issue:
        die(f"Issue #{arg} not found")
    return id, issue

# --- Formatting ---

def ago(ts):
    dt = datetime.fromisoformat(ts.replace('Z', '+00:00'))
    diff = datetime.now(dt.tzinfo) - dt
    if diff.days > 0:
        return f"{diff.days}d ago"
    if diff.seconds > 3600:
        return f"{diff.seconds // 3600}h ago"
    if diff.seconds > 60:
        return f"{diff.seconds // 60}m ago"
    return "just now"

def refs(ids):
    return ', '.join(f'#{num(i)}' for i in ids)

# --- State Machine ---

TERMINAL = {"completed", "abandoned"}
ACTIVE = {"draft", "review", "approved"}

def pending(issue):
    return [r for r in issue.get("reviewers", [])
            if r not in issue.get("approved_by", [])]

def on_submit(issue, **_):
    issue["attention"] = issue["reviewers"].copy() if issue["reviewers"] else [issue["owner"]]

def on_comment(issue, u, text, **_):
    issue["comments"].append({"author": u, "time": now(), "text": text})
    if issue["status"] in TERMINAL:
        return  # no attention shift on closed issues
    if u == issue["owner"]:
        issue["attention"] = pending(issue) or [issue["owner"]]
    else:
        issue["attention"] = [issue["owner"]]

def on_approve(issue, u, **_):
    if u not in issue.get("reviewers", []):
        die("Not a reviewer")
    if u not in issue.get("approved_by", []):
        issue.setdefault("approved_by", []).append(u)
    issue["attention"] = pending(issue) or [issue["owner"]]

def all_approved(issue, **_):
    return set(issue.get("reviewers", [])) == set(issue.get("approved_by", []))

def clear_attention(issue, **_):
    issue["attention"] = []

def on_block(a, b):
    if b["id"] not in a.setdefault("blocked_by", []):
        a["blocked_by"].append(b["id"])
    if a["id"] not in b.setdefault("blocks", []):
        b["blocks"].append(a["id"])

def on_unblock(a, b):
    if b["id"] in a.get("blocked_by", []):
        a["blocked_by"].remove(b["id"])
    if a["id"] in b.get("blocks", []):
        b["blocks"].remove(a["id"])

TRANSITIONS = {
    "submit":   ({"draft"},  "review",    on_submit),
    "comment":  (ACTIVE | TERMINAL, None, on_comment),
    "approve":  ({"review"}, "approved",  on_approve, all_approved),
    "complete": (ACTIVE,     "completed", clear_attention),
    "abandon":  (ACTIVE,     "abandoned", clear_attention),
}

def transition(issue, name, **ctx):
    t = TRANSITIONS.get(name)
    if not t:
        die(f"Unknown transition: {name}")

    frm, to, action = t[:3]
    guard = t[3] if len(t) > 3 else lambda **_: True

    if issue["status"] not in frm:
        die(f"Cannot {name} from '{issue['status']}'")

    action(issue, **ctx)
    if to and guard(issue=issue, **ctx):
        issue["status"] = to

# --- Views ---

def cmd_show(args):
    _, i = fetch(args.id)
    print(f"#{num(i['id'])} {i['title']}")
    print(f"status: {i['status']}  owner: {i['owner']}")
    for k in ['reviewers', 'approved_by', 'attention', 'blocked_by', 'blocks', 'labels']:
        if v := i.get(k):
            print(f"{k}: {refs(v) if k in ('blocked_by', 'blocks') else ', '.join(v)}")
    print(f"created: {i['created']}  updated: {i['updated']}")
    if i['description']:
        print("\n" + i['description'])
    if i['comments']:
        print("\ncomments:")
        for c in i['comments']:
            print(f"  {c['author']} ({ago(c['time'])}): {c['text']}")

def cmd_list(args):
    issues = all_issues()

    filters = [
        (args.owner,    lambda i, v: i['owner'] == v.replace('@me', user())),
        (args.status,   lambda i, v: i['status'] in v.split(',')),
        (args.reviewer, lambda i, v: v.replace('@me', user()) in i.get('reviewers', [])),
        (args.label,    lambda i, v: v in i.get('labels', [])),
        (args.blocked,  lambda i, _: i.get('blocked_by')),
        (args.blocking, lambda i, _: i.get('blocks')),
    ]
    for val, pred in filters:
        if val:
            issues = [i for i in issues if pred(i, val)]

    if not issues:
        print("No issues found")
        return

    for i in issues:
        marks = ""
        if i.get('attention'): marks += " ⚠️"
        if i['blocks']: marks += f" [blocks: {len(i['blocks'])}]"
        if i['blocked_by']: marks += f" [blocked: {len(i['blocked_by'])}]"
        print(f"#{num(i['id']):<3} {i['status']:10} {i['owner']:15} {i['title']}{marks}")

def inbox_issues():
    u = user()
    items = [i for i in all_issues()
             if u in i.get('attention', []) and i['status'] not in TERMINAL]
    # Sort: blocking first, priority desc, then by id
    return sorted(items, key=lambda i: (not i.get('blocks'), -i.get('priority', 0), i['id']))

def outbox_issues():
    u = user()
    items = [i for i in all_issues()
             if i['owner'] == u and u not in i.get('attention', [])
             and i['status'] not in TERMINAL]
    return sorted(items, key=lambda i: (-i.get('priority', 0), i['id']))

def line(i, arrow_to=None):
    u = user()
    owner = 'YOU' if i['owner'] == u else i['owner']
    arrow = arrow_to or owner
    pri = f"P{i['priority']}" if i.get('priority') else "-"
    deps = f"blks:{len(i['blocks'])}" if i.get('blocks') else \
           f"blkd:{len(i['blocked_by'])}" if i.get('blocked_by') else "-"
    comment = f'"{i["comments"][-1]["text"][:20]}"' if i.get('comments') else '-'
    print(f"  #{num(i['id']):<2} {pri:3} {i['status']:8} {arrow:12} [{i['title'][:25]:25}] {deps:8} {comment}")

def cmd_inbox(_):
    items = inbox_issues()
    if not items:
        print("Inbox empty!")
        return False
    print(f"INBOX ({len(items)})")
    for i in items:
        line(i)
    return True

def cmd_outbox(_):
    items = outbox_issues()
    if not items:
        print("Outbox empty!")
        return False
    print(f"OUTBOX ({len(items)})")
    for i in items:
        line(i, ', '.join(i.get('attention', ['?']))[:12])
    return True

def cmd_default(_):
    has = cmd_inbox(None)
    if has: print()
    has2 = cmd_outbox(None)
    if has2: print()
    if not has and not has2:
        print("No active issues.")

# --- Mutations ---

def cmd_create(args):
    DIR.mkdir(exist_ok=True)
    ts = now()
    owner = args.owner or user()

    title = args.title
    priority = args.priority or 0
    reviewers = args.reviewers or []
    cc = args.cc or []
    labels = args.labels or []
    blocked_by = []
    blocks = []
    comment = None

    if not title:
        text = edit(f"""\
Owner: {owner}
Priority: {priority}
Reviewers: {', '.join(reviewers)}
CC: {', '.join(cc)}
Labels: {', '.join(labels)}
Blocked-by:
Blocks:

# Title on next blank line, then comment body
# Lines starting with # are stripped
""")
        meta = {}
        lines = []
        for line in text.split('\n'):
            if line.startswith('#'):
                continue
            if ':' in line and not lines and not meta.get('_done'):
                key, val = line.split(':', 1)
                meta[key.strip().lower().replace('-', '_')] = val.strip()
                continue
            meta['_done'] = True
            lines.append(line)

        def parse_list(s):
            return [x.strip() for x in s.split(',') if x.strip()]

        def parse_refs(s):
            ids = []
            for r in parse_list(s):
                id = resolve(r.lstrip('#'))
                if id:
                    ids.append(id)
            return ids

        if meta.get('owner'):
            owner = meta['owner']
        if meta.get('priority'):
            priority = int(meta['priority'])
        if meta.get('reviewers'):
            reviewers = parse_list(meta['reviewers'])
        if meta.get('cc'):
            cc = parse_list(meta['cc'])
        if meta.get('labels'):
            labels = parse_list(meta['labels'])
        if meta.get('blocked_by'):
            blocked_by = parse_refs(meta['blocked_by'])
        if meta.get('blocks'):
            blocks = parse_refs(meta['blocks'])

        while lines and not lines[0].strip():
            lines.pop(0)
        title = lines[0].strip() if lines else ""
        if not title:
            die("Aborted: no title")
        body = '\n'.join(lines[1:]).strip()
        if body:
            comment = body

    issue = {
        "id": uuid.uuid7().hex,
        "title": title,
        "status": "draft",
        "owner": owner,
        "priority": priority,
        "reviewers": reviewers,
        "cc": cc,
        "created": ts,
        "updated": ts,
        "blocked_by": blocked_by,
        "blocks": blocks,
        "labels": labels,
        "description": args.description or "",
        "comments": [],
        "attention": [owner],
    }
    if comment:
        issue["comments"].append({"author": owner, "time": ts, "text": comment})
    # Update reverse links
    for bid in blocked_by:
        blocker = load(bid)
        if blocker and issue["id"] not in blocker.get("blocks", []):
            blocker.setdefault("blocks", []).append(issue["id"])
            save(blocker)
    for bid in blocks:
        blocked = load(bid)
        if blocked and issue["id"] not in blocked.get("blocked_by", []):
            blocked.setdefault("blocked_by", []).append(issue["id"])
            save(blocked)
    save(issue)
    print(f"Created #{num(issue['id'])}: {title}")
    print(f"Attention: {owner}")

def cmd_do(action, args):
    _, issue = fetch(args.id)
    transition(issue, action, u=user(), text=getattr(args, 'text', None))
    save(issue)

    past = {"submit": "Submitted", "comment": "Commented on", "approve": "Approved"}
    print(f"{past.get(action, action.title() + 'ed')} #{args.id}")
    print(f"Attention: {', '.join(issue['attention'])}")

def cmd_comment(args):
    # Default to first inbox issue
    if not args.id:
        inbox = inbox_issues()
        if not inbox:
            die("No issues in inbox")
        id = inbox[0]['id']
    else:
        id = resolve(args.id)
        if not id:
            die(f"Issue #{args.id} not found")

    issue = load(id)
    text = args.text
    if not text:
        issue_yaml = yaml.dump(issue, default_flow_style=False, sort_keys=False)
        commented = '\n'.join(f'# {l}' for l in issue_yaml.split('\n'))
        text = edit(f"{commented}\n\n").strip()
        text = '\n'.join(l for l in text.split('\n') if not l.startswith('#')).strip()
        if not text:
            die("Aborted: no comment")

    transition(issue, "comment", u=user(), text=text)
    save(issue)
    print(f"Commented on #{num(id)}")
    print(f"Attention: {', '.join(issue['attention'])}")

def cmd_update(args):
    # Default to first inbox issue
    if not args.id:
        inbox = inbox_issues()
        if not inbox:
            die("No issues in inbox")
        id = inbox[0]['id']
    else:
        id = resolve(args.id)
        if not id:
            die(f"Issue #{args.id} not found")

    path = DIR / f"{id}.yaml"
    has_flags = args.status or args.owner or args.title or args.priority is not None \
                or args.add_reviewer or args.add_label

    # No flags: open editor directly on yaml file
    if not has_flags:
        editor = os.environ.get("EDITOR", "vi")
        subprocess.run(f'{editor} "{path}"', shell=True)
        print(f"Updated #{num(id)}")
        return

    issue = load(id)
    if args.status:
        if args.status in TERMINAL:
            action = "complete" if args.status == "completed" else "abandon"
            transition(issue, action)
        else:
            issue["status"] = args.status

    if args.owner:
        issue["owner"] = args.owner
    if args.title:
        issue["title"] = args.title
    if args.priority is not None:
        issue["priority"] = args.priority

    for r in (args.add_reviewer or []):
        if r not in issue.setdefault("reviewers", []):
            issue["reviewers"].append(r)
    for label in (args.add_label or []):
        if label not in issue.setdefault("labels", []):
            issue["labels"].append(label)

    save(issue)
    print(f"Updated #{num(id)}")

def cmd_link(args, add=True):
    a_id, a = fetch(args.id)
    b_id, b = fetch(args.blocker_id)
    (on_block if add else on_unblock)(a, b)
    save(a)
    save(b)
    print(f"#{num(a_id)} {'blocked by' if add else 'unblocked from'} #{num(b_id)}")

# --- CLI ---

CMDS = ["create", "show", "list", "update", "comment", "submit", "approve", "block", "unblock", "inbox", "outbox"]

def main():
    # Expand command prefix before argparse sees it
    if len(sys.argv) > 1 and sys.argv[1] not in CMDS and not sys.argv[1].startswith('-'):
        matches = [c for c in CMDS if c.startswith(sys.argv[1])]
        if len(matches) == 1:
            sys.argv[1] = matches[0]
        elif len(matches) > 1:
            die(f"Ambiguous: {', '.join(matches)}")

    p = argparse.ArgumentParser(description="Issue tracker. Run without args for inbox/outbox summary.")
    s = p.add_subparsers(dest="cmd", metavar="command")

    c = s.add_parser("create", help="create new issue")
    c.add_argument("title", nargs="?", help="omit to open $EDITOR")
    c.add_argument("-d", "--description")
    c.add_argument("--owner", help="default: you")
    c.add_argument("-p", "--priority", type=int, help="higher = more important")
    c.add_argument("-r", "--reviewers", nargs="+")
    c.add_argument("--cc", nargs="+")
    c.add_argument("-l", "--labels", nargs="+")

    s.add_parser("show", help="show issue details").add_argument("id")
    s.add_parser("submit", help="submit for review (draft→review)").add_argument("id")
    s.add_parser("approve", help="approve issue (review→approved)").add_argument("id")

    c = s.add_parser("comment", help="add comment")
    c.add_argument("id", nargs="?", help="default: first inbox issue")
    c.add_argument("text", nargs="?", help="omit to open $EDITOR")

    c = s.add_parser("list", help="list issues with filters")
    c.add_argument("--owner")
    c.add_argument("--status", help="comma-separated")
    c.add_argument("--reviewer")
    c.add_argument("--label")
    c.add_argument("--blocked", action="store_true")
    c.add_argument("--blocking", action="store_true")

    c = s.add_parser("update", help="update issue fields")
    c.add_argument("id", nargs="?", help="default: first inbox issue")
    c.add_argument("--status", choices=["draft", "review", "approved", "completed", "abandoned"])
    c.add_argument("--owner")
    c.add_argument("--title")
    c.add_argument("-p", "--priority", type=int)
    c.add_argument("--add-reviewer", nargs="+")
    c.add_argument("--add-label", nargs="+")

    c = s.add_parser("block", help="mark issue as blocked by another")
    c.add_argument("id")
    c.add_argument("blocker_id")
    c = s.add_parser("unblock", help="remove blocking relationship")
    c.add_argument("id")
    c.add_argument("blocker_id")

    s.add_parser("inbox", help="issues needing your action")
    s.add_parser("outbox", help="your issues waiting on others")

    args = p.parse_args()

    cmds = {
        "create": cmd_create,
        "show": cmd_show,
        "list": cmd_list,
        "update": cmd_update,
        "comment": cmd_comment,
        "submit": lambda a: cmd_do("submit", a),
        "approve": lambda a: cmd_do("approve", a),
        "block": lambda a: cmd_link(a, add=True),
        "unblock": lambda a: cmd_link(a, add=False),
        "inbox": cmd_inbox,
        "outbox": cmd_outbox,
    }
    cmds.get(args.cmd, cmd_default)(args)

if __name__ == "__main__":
    main()
